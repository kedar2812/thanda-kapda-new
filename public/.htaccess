Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://thandakapda.co%{REQUEST_URI} [L,R=301]

  # Next.js prefetches "__next.<route>.__PAGE__.txt" but the static export
  # writes those files as "__next.<route>/__PAGE__.txt"; map one to the other.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.__PAGE__\.txt$ $1__next.$2/$3/__PAGE__.txt [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)?__next\.([^./]+)\.__PAGE__\.txt$ $1__next.$2/__PAGE__.txt [L]
</IfModule>

<IfModule mod_setenvif.c>
  # Next.js checks each link with a HEAD request before prefetching it. A HEAD
  # answer marked as gzip but with no body fails in Chrome, so don't compress it.
  SetEnvIf Request_Method "^HEAD$" no-gzip
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Only the dashboard may show the site in a frame (its live preview).
  Header always set Content-Security-Policy "frame-ancestors 'self' https://admin.thandakapda.co"
</IfModule>
